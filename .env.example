# SMTP 邮件服务器配置（iCloud Mail 示例）
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USE_SSL=false

# 发件邮箱和密码
# 对于 iCloud，使用 Apple ID 邮箱和应用专用密码（非 Apple ID 登录密码）
# 应用专用密码可在 appleid.apple.com 的"登录与安全性 → App 专用密码"中创建
SMTP_USER=your-email@icloud.com
SMTP_PASSWORD=your-app-specific-password

# macOS 钥匙串配置（可选）
# 如果使用 macOS 钥匙串存储密码，可以留空 SMTP_PASSWORD
# SMTP_PASSWORD=
# SMTP_KEYCHAIN_SERVICE=WCA Watch SMTP

# 收件邮箱（多个地址用英文逗号分隔）
MAIL_TO=recipient@example.com

# 发件人显示名称
MAIL_FROM_NAME=WCA Watch

# 邮件中报名时间的显示时区（默认北京时间）
MAIL_TIMEZONE=Asia/Shanghai
# 可选：自定义邮件中的时区名称
# MAIL_TIMEZONE_LABEL=北京时间

# 可选：只通知指定国家/地区的比赛（ISO 3166-1 两位代码）
# 留空表示全球所有比赛；多个国家用英文逗号分隔
# 示例：
#   CN - 中国大陆
#   HK - 中国香港
#   TW - 中国台湾
#   MO - 中国澳门
#   US - 美国
#   JP - 日本
WCA_COUNTRY_CODES=

# 其他常见 SMTP 服务器配置参考：
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_SSL=false
#
# QQ 邮箱:
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=587
#   SMTP_USE_SSL=false
#
# 163 邮箱:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USE_SSL=true
