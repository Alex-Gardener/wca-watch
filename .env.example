# iCloud Mail（Apple ID 应用专用密码，不是 Apple ID 登录密码）
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your-name@icloud.com
# 推荐将密码保存在 macOS 钥匙串；也可在这里填写 SMTP_PASSWORD
SMTP_PASSWORD=
SMTP_KEYCHAIN_SERVICE=WCA Watch SMTP

# 多个收件人用英文逗号分隔
MAIL_TO=your-address@example.com
MAIL_FROM_NAME=WCA Watch

# 可选：只通知指定国家，使用 ISO 3166-1 两位代码；留空表示全球
# 示例：中国大陆为 CN；中国香港为 HK；中国澳门为 MO；中国台湾为 TW
WCA_COUNTRY_CODES=
